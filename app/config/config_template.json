{
    "dataset": {
        "columns": {
            "case_id": "case_id",
            "activity": "concept:name",
            "timestamp": "time:timestamp"
        }
    },
    "filter": {
        "enabled": false,
        "events": [
            "\\core\\event\\course_viewed"
        ],
        "export_formats": ["xes", "csv"]
    },
    "preprocess": {
        "enabled": true,
        "mapping_activity_json_path": "/dataset/activity_mappings/moodle_activity_mapping.json"
    },
    "discovery": {
        "petri_net": {
            "enabled": true,
            "infrequent_ratio": 0.0
        },
        "bpmn": {
            "enabled": true,
            "infrequent_ratio": 0.0
        },
        "dfg": {
            "enabled": true,
            "performance-enabled": true
        },
        "temporal_profile": {
            "enabled": true
        }
    },
    "llm": {
        "llm_provider": "ollama",
        "huggingface": {
            "hugging_face_api_key": "your_hugging_face_api_key",
            "model_name": "mistralai/Mistral-7B-Instruct-v0.2",
            "model_type": "text-generation-inference",
            "max_tokens": 3000
        },
        "ollama": {
            "api_url": "http://myurl.es:11434",
            "api_endpoint": "/api/chat",
            "model_name": "gemma3:27b-it-qat",
            "options": {
                "num_ctx": 16384,
                "num_predict": 6144,
                "temperature": 0.2,
                "top_p": 0.95
            },
            "max_prompt_tokens": 14000,
            "think": false,
            "json_prompt_config": {
                "api_url": "http://genialle.uca.es:11434",
                "api_endpoint": "/api/generate",
                "model_name": "dfg-simplifier-mistral-7b",
                "options": {
                    "temperature": 0.1,
                    "top_p": 0.95
                },
                "max_prompt_tokens": 14000,
                "think": false
            }
        },
        "openai": {
            "api_key": "your_openai_api_key",
            "model_name": "gpt-5-mini",
            "think": {"effort": "medium"},
            "max_tokens": 3000
        },
        "gemini": {
            "api_key": "your_gemini_api_key",
            "model_name": "gemini-3-flash-preview",
            "think": {"thinkingLevel": "high"}
         },
        "context": [
            "Context for the next prompts:",
            "process models obtained using process mining techniques will be provided later. The process consists of a serious game focused on designing an Entity-Relationship (ER) diagram to model a relational database based on given requirements within the game. The players are students enrolled in a mandatory course called \"Databases\", which is part of the second year curriculum for a Computer Science degree at the University of Cádiz. The proposed solution contained 6 entities, 19 attributes, 7 binary relations and their 14 cardinalities. The results will be used to analyze the students' performance and to improve the understanding of ER modeling concepts in the course considering the detected insights after analyzing the process models. Based on the detected patterns and their metrics, provide interpretative insights, such as iterative processes, starting points, heterogeneous behavior, deletion activities, structured subprocesses, linked activities, parallelism, attribute links, end patterns, loop behavior, suitable frequencies, and variability. Justify the provided insights."
        ],
        "petri_net": {
            "enabled": false,
            "prompt": "Model used is a Petri Net."
        },
        "dfg": {
            "enabled": false,
            "prompt": "Model used is a DFG.",
            "simplify_dfg": {
                "enabled": true,
                "simplification_context_prompt": "prompts/dfg_simplify/context_template.txt",
                "removing_transitions_ratio": 50,
                "retaining_transitions_ratio": 20,
                "simplification_instructions_prompt": "prompts/dfg_simplify/instructions_using_activities_template.txt",
                "simplification_analysis_prompt": "prompts/dfg_simplify/analysis_template.txt"
            }
        },
        "temporal_profile": {
            "enabled": false,
            "prompt": "Model used is a Temporal Profile."
        }
    },
    "mermaid": {
        "prompt": "prompts/mermaid_template.txt",
        "image_format": "svg"
    }
}